# Copy to .env (never commit the real .env) and fill in:

# Discord Developer Portal > Your App > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Discord Developer Portal > Your App > General Information > Application ID
DISCORD_CLIENT_ID=

# Discord app > right-click your server icon > Copy Server ID
# (needs Developer Mode enabled in Discord settings > Advanced)
# Optional but recommended: guild-scoped commands register instantly,
# global ones can take up to an hour to show up everywhere.
DISCORD_GUILD_ID=

# Chekssa server the bot should connect to as a client.
CHEKSSA_SERVER_URL=https://chekssa.hodindorian.com

# Session code used when /envoyer is called without an explicit "code" option.
DEFAULT_SESSION_CODE=REPS2.0
